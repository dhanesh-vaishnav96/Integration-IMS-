# ==========================================
# MICROSOFT TEAMS INTERVIEW MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION (.env.example)
# ==========================================

# ─── 1. SERVER CONFIGURATION ───
# Application environment (development | staging | production)
NODE_ENV=development
# Port for the Node.js backend to run on
PORT=5000
# JWT Secret for authenticating Dashboard and Teams routes
JWT_SECRET=your_super_secret_jwt_key_here

# ─── 2. DATABASE CONFIGURATION ───
# Primary PostgreSQL connection (RDS Write endpoint or local)
# Format: postgresql://{user}:{password}@{host}:{port}/{dbname}?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/interview_os?schema=public

# Read Replica connection (dashboard/list queries are routed here)
# On local dev, set to same value as DATABASE_URL
# On AWS RDS, set to the read replica endpoint
DATABASE_READ_URL=postgresql://postgres:password@localhost:5432/interview_os?schema=public

# Feature flag: which DB provider to use (mongo | postgres)
# Set to 'mongo' to keep using Mongoose during dual-DB migration window
# Set to 'postgres' once RDS is validated
DB_PROVIDER=postgres

# ─── 3. MICROSOFT GRAPH API ───
# The Azure AD Tenant ID where the App is registered
TENANT_ID=your_azure_tenant_id
# The Client ID (App ID) of the registered Azure App
CLIENT_ID=your_azure_client_id
# The Client Secret generated in Azure App Registration
CLIENT_SECRET=your_azure_client_secret
# The Auth Mode (MUST be 'application' for background processing)
AUTH_MODE=application
# Public URL where Microsoft Graph will send webhooks (e.g., https://api.yourdomain.com/api/v1/webhooks/teams)
WEBHOOK_NOTIFICATION_URL=https://your-ngrok-url.app/api/v1/webhooks/teams
# Required permissions for Graph APIs
GRAPH_SCOPES=https://graph.microsoft.com/.default

# ─── 4. AWS SQS QUEUE ───
# AWS Region where the SQS queue resides
AWS_REGION=us-east-1
# AWS IAM User Access Key (Must have SQS SendMessage, ReceiveMessage, DeleteMessage)
AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS IAM User Secret Key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# The full URL to the SQS FIFO or Standard Queue
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/webhook-queue.fifo
# Max number of messages to process concurrently (1-10)
SQS_BATCH_SIZE=5
# SQS Long polling wait time
SQS_WAIT_TIME_SECONDS=20
# Visibility timeout (Should be at least 900s / 15 mins to cover p-retry limits)
SQS_VISIBILITY_TIMEOUT=900

# ─── 5. AWS S3 STORAGE ───
# The name of the S3 Bucket to store recordings and transcripts
S3_BUCKET_NAME=your-interview-assets-bucket
